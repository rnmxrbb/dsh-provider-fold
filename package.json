{
  "name": "dsh-provider-fold",
  "version": "1.0.0",
  "type": "module",
  "description": "Collapsible provider groups with prominent headings in the DSH model selection menu. / DSH 模型选择菜单的厂商分组折叠 + 醒目厂商标题。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-selection",
    "ui"
  ],
  "license": "MIT",
  "author": "rnmxrbb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnmxrbb/dsh-provider-fold.git"
  },
  "homepage": "https://github.com/rnmxrbb/dsh-provider-fold#readme",
  "bugs": {
    "url": "https://github.com/rnmxrbb/dsh-provider-fold/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "scripts": {
    "test": "node test/verify-client.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
